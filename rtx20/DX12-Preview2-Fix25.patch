+ struct Job {std::uint64_t value;NvofD3D11* session;ID3D11Texture2D* previous;ID3D11Texture2D* current;ID3D11Texture2D* flows[2];};
+ std::mutex mutex;std::condition_variable wake,idle;std::deque<Job> jobs;
+ bool stopping{},running{};HRESULT failure{S_OK};std::uint64_t value{};
+ std::thread worker;
+ static constexpr size_t maximum_queued=3;
+ void run(){
+  for(;;){
+   Job job{};
+   {std::unique_lock lock(mutex);wake.wait(lock,[&]{return stopping||!jobs.empty();});
+    if(jobs.empty()){running=false;idle.notify_all();return;}
+    job=jobs.front();}
+   // The flow must not start before the game device has written the frames.
+   HRESULT hr=context4->Wait(readyPrivate.Get(),job.value);
+   bool skip=FAILED(hr);
+   {std::scoped_lock lock(mutex);skip|=FAILED(failure);}
+   if(!skip)hr=job.session->execute(job.previous,job.current,job.flows);
+   // Always signalled: the game device already waits for this value.
+   const HRESULT signalled=context4->Signal(donePrivate.Get(),job.value);context->Flush();
+   std::scoped_lock lock(mutex);
+   if(FAILED(hr)&&SUCCEEDED(failure))failure=hr;
+   if(FAILED(signalled))failure=signalled;
+   jobs.pop_front();idle.notify_all();
+  }
+ }
+};
+AsyncFlow::AsyncFlow():impl_(std::make_unique<Impl>()){}
+AsyncFlow::~AsyncFlow(){
+ // A worker that did not finish still references the private device.
+ if(impl_&&!stop())(void)impl_.release();
