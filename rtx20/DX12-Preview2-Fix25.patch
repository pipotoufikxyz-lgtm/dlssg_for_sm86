+ // the flow after all queued game-device work and the game device's later
+ // work after the flow. Textures are the private device's. A failure before
+ // anything was queued returns an error with no GPU wait left behind; a
+ // failed flow reported by the worker is returned by the next submit.
+ HRESULT submit(NvofD3D11* session,ID3D11Texture2D* previous,ID3D11Texture2D* current,ID3D11Texture2D* const flows[2]) noexcept;
+ // Waits (bounded) until every submitted flow has been executed.
+ bool drain() noexcept;
+ // Drains and ends the worker; false if it did not finish (the caller then
+ // keeps every resource alive).
+ bool stop() noexcept;
+};
+}
