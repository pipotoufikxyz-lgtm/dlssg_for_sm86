+struct AsyncFlow::Impl {
+ // Game device side.
+ ComPtr<ID3D11Device5> game;ComPtr<ID3D11DeviceContext> gameContext;ComPtr<ID3D11DeviceContext4> gameContext4;
+ ComPtr<ID3D11Fence> readyGame,doneGame;
