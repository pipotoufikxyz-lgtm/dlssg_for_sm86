+ ComPtr<ID3D11Device> device;ComPtr<ID3D11Device1> device1;ComPtr<ID3D11Device5> device5;
+ ComPtr<ID3D11DeviceContext> context;ComPtr<ID3D11DeviceContext4> context4;
