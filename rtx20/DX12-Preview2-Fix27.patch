+// Fix26 (World of Warcraft, nvsmooth30_63.log): a D3D12 swapchain adopted at
+// its first Present (the game created it before any hook could see the
+// creation call) has no known presentation queue, and DXGI would not return
+// it; interpolation stayed off until the game re-created its renderer. The
+// game's DIRECT queues on the swapchain's device are counted as they submit
+// work; the one submitting most (ties: from the presenting thread) is taken.
+struct QueueTally {
+ struct Entry {const void* key=nullptr;unsigned count=0;unsigned long thread=0;};
+ static constexpr unsigned capacity=8,minimum=8;
+ std::array<Entry,capacity> entries{};
+ // Index of key's entry (new entries take a free one), -1 when full.
+ int record(const void* key,unsigned long thread){
+  if(!key)return -1;
+  for(unsigned i=0;i<capacity;++i)if(entries[i].key==key){++entries[i].count;entries[i].thread=thread;return int(i);}
+  for(unsigned i=0;i<capacity;++i)if(!entries[i].key){entries[i]={key,1,thread};return int(i);}
+  return -1;
+ }
+ int choose(unsigned long presentThread) const {
+  int best=-1;
+  for(unsigned i=0;i<capacity;++i){
+   const auto& e=entries[i];if(!e.key||e.count<minimum)continue;
