 inline unsigned grid_extent(unsigned n) { return (n+3)/4; }
 inline bool dimensions(unsigned w,unsigned h) { return w>=128 && h>=128 && w<=3840 && h<=2160; }
+// Optical-flow resolution. Full-resolution NVOF (4-pixel cells) preserves thin
+// detail; half resolution (8-pixel cells) costs about a quarter of the flow
+// GPU time. Automatic mode uses half resolution only when the real frame rate
+// is already high: motion per frame is then small and GPU time decides the
+// generated frame rate. Hysteresis avoids switching back and forth.
+enum class FlowResolution { automatic, full, half };
+inline FlowResolution parse_flow_resolution(const wchar_t* value) {
+ if(!value)return FlowResolution::automatic;
+ auto same=[&](const wchar_t* word){const wchar_t* a=value;const wchar_t* b=word;
+  for(;*a&&*b;++a,++b){wchar_t c=*a;if(c>=L'A'&&c<=L'Z')c=wchar_t(c-L'A'+L'a');if(c!=*b)return false;}return !*a&&!*b;};
+ if(same(L"full"))return FlowResolution::full;
+ if(same(L"half"))return FlowResolution::half;
+ return FlowResolution::automatic;
+}
+inline constexpr double half_flow_enter_fps=58, half_flow_leave_fps=45;
+inline bool use_half_flow(FlowResolution setting,bool available,bool current,double realFps) {
+ if(!available||setting==FlowResolution::full)return false;
+ if(setting==FlowResolution::half)return true;
+ return realFps>=(current?half_flow_leave_fps:half_flow_enter_fps);
+}
+// Exponential average of the real frame interval; gaps longer than the
+// history window (pauses, F11, loading) restart the measurement.
+inline double update_frame_interval(double average,double seconds) {
+ if(!(seconds>0)||seconds>0.25)return 0;
+ return average>0?average+(seconds-average)*0.1:seconds;
+}
 }
