+// without stalling. Stages: capture (+ half-resolution copy), optical flow,
+// synthesis (projection, synthesis and resolve). Also counts pairs per flow
+// resolution so logs show which mode produced the timings.
+enum class GpuPhase { capture, optical_flow, synthesis, count };
+inline std::array<Sample,static_cast<unsigned>(GpuPhase::count)> gpu_samples{};
+inline constexpr const char* gpu_names[]={"capture","optical_flow","synthesis"};
+inline std::atomic_ullong full_flow_pairs{},half_flow_pairs{};
+inline void add_gpu(GpuPhase phase,unsigned long long us){
+ auto& s=gpu_samples[static_cast<unsigned>(phase)];s.total_us.fetch_add(us,std::memory_order_relaxed);s.calls.fetch_add(1,std::memory_order_relaxed);
+ auto old=s.max_us.load(std::memory_order_relaxed);
+ while(old<us&&!s.max_us.compare_exchange_weak(old,us,std::memory_order_relaxed)){}
+}
