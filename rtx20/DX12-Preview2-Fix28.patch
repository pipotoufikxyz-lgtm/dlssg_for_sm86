+ if(!inst.GetPhysicalDeviceFeatures2)return false;
+ VkPhysicalDeviceTimelineSemaphoreFeatures tf{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES};
+ VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};f2.pNext=&tf;inst.GetPhysicalDeviceFeatures2(physical,&f2);
+ if(!tf.timelineSemaphore){log("[vulkan] Timeline semaphores unsupported: generation unavailable.\n");return false;}
+ for(auto* e:wanted){bool present=false;for(auto* x:out.extensions)if(!std::strcmp(x,e))present=true;if(!present)out.extensions.push_back(e);}
+ out.info.enabledExtensionCount=std::uint32_t(out.extensions.size());out.info.ppEnabledExtensionNames=out.extensions.data();
