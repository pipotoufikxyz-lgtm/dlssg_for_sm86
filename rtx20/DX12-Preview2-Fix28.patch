+// --- per-chain resources -------------------------------------------------
+inline void destroy_chain_resources(Chain& c){
+ auto& d=*c.device;
+ for(auto& s:c.slots){
+  VkFence fences[2];unsigned n=0;
+  if(s.captureBusy)fences[n++]=s.captureFence;if(s.generatedBusy)fences[n++]=s.generatedFence;
+  if(n)d.WaitForFences(d.device,n,fences,VK_TRUE,1000000000ull);
+ }
+ if(c.generator){c.generator->quiesce();c.generator.reset();}
+ for(auto& s:c.slots){
+  if(s.captureFence)d.DestroyFence(d.device,s.captureFence,nullptr);
+  if(s.generatedFence)d.DestroyFence(d.device,s.generatedFence,nullptr);
+  for(auto sem:{s.realReady,s.acquired,s.generatedDone})if(sem)d.DestroySemaphore(d.device,sem,nullptr);
+  s={};
+ }
+ if(c.pool)d.DestroyCommandPool(d.device,c.pool,nullptr);c.pool=VK_NULL_HANDLE;
+}
+inline bool create_chain_resources(Chain& c){
+ auto& d=*c.device;
+ VkCommandPoolCreateInfo pi{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};pi.flags=VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;pi.queueFamilyIndex=c.queueFamily;
