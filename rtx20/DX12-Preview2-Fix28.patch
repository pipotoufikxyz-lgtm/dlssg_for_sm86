+ if(!d.WaitSemaphores)d.WaitSemaphores=reinterpret_cast<PFN_vkWaitSemaphores>(d.gdpa(d.device,"vkWaitSemaphoresKHR"));
+ if(!d.SignalSemaphore)d.SignalSemaphore=reinterpret_cast<PFN_vkSignalSemaphore>(d.gdpa(d.device,"vkSignalSemaphoreKHR"));
+ if(!d.GetSemaphoreCounterValue)d.GetSemaphoreCounterValue=reinterpret_cast<PFN_vkGetSemaphoreCounterValue>(d.gdpa(d.device,"vkGetSemaphoreCounterValueKHR"));
+}
+inline bool supported_format(VkFormat f){
+ return f==VK_FORMAT_B8G8R8A8_UNORM||f==VK_FORMAT_B8G8R8A8_SRGB||f==VK_FORMAT_R8G8B8A8_UNORM||f==VK_FORMAT_R8G8B8A8_SRGB||f==VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+}
+}
