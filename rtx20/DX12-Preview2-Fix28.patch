+// Loader-layer interface version 2 negotiation (the only export).
+#if defined(__clang__)
+#pragma clang diagnostic ignored "-Wdll-attribute-on-redeclaration"
+#endif
+extern "C"
+#ifdef _WIN32
+__declspec(dllexport)
+#else
+__attribute__((visibility("default")))
+#endif
+VkResult VKAPI_CALL vkNegotiateLoaderLayerInterfaceVersion(VkNegotiateLayerInterface* v){
+ if(!v||v->sType!=LAYER_NEGOTIATE_INTERFACE_STRUCT)return VK_ERROR_INITIALIZATION_FAILED;
+ if(v->loaderLayerInterfaceVersion<2)return VK_ERROR_INITIALIZATION_FAILED;
+ v->loaderLayerInterfaceVersion=2;
+ v->pfnGetInstanceProcAddr=&smvk::GetInstanceProcAddr;v->pfnGetDeviceProcAddr=&smvk::GetDeviceProcAddr;
+ v->pfnGetPhysicalDeviceProcAddr=nullptr;
+ return VK_SUCCESS;
+}
