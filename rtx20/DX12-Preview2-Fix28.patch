+inline VkResult present(DeviceData& d,VkQueue queue,const VkPresentInfoKHR* info){
+ if(info->swapchainCount!=1)return d.QueuePresentKHR(queue,info);
+ Chain* c=nullptr;
+ {auto& s=state();std::scoped_lock l(s.lock);auto i=s.chains.find(info->pSwapchains[0]);if(i!=s.chains.end())c=i->second.get();}
+ if(!c||c->disabled||!c->generator||d.family(queue)!=c->queueFamily)return d.QueuePresentKHR(queue,info);
+ auto& slot=c->slots[c->next];c->next=(c->next+1)%c->slots.size();
+ PresentOps ops(*c,queue,*info,slot);
+ if(!ops.ready()){c->disabled=true;log("[vulkan] GPU work of an earlier frame did not finish within 1 s; generation stopped for this swapchain.\n");return d.QueuePresentKHR(queue,info);}
+ return c->generator->present(ops);
+}
