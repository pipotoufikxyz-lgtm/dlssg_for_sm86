+// Fix28: Vulkan frame generation on Windows (RDR2 and other Vulkan games).
+//
+// Registration: at load, this module writes a Vulkan layer manifest naming
+// itself and points the Vulkan loader at it through this process's
+// environment (VK_ADD_LAYER_PATH / VK_LAYER_PATH and VK_INSTANCE_LAYERS), so
+// the loader inserts it into the game's instance and device call chains the
+// standard way. Nothing is installed system-wide. Vulkan=0 in nvsmooth30.ini
+// (or SM86_VULKAN=0) disables it.
+//
+// Bridge: each eligible swapchain gets two D3D11 textures shared with Vulkan
+// (the captured real frame and the generated frame) and a D3D11 fence shared
+// as a Vulkan timeline semaphore. The real frame is copied on the game's
+// queue, the existing D3D11 interpolator (NVIDIA optical flow, synthesis,
+// presentation policy) computes the generated frame, which is copied into a
+// free swapchain image and presented before the game's own image.
+#ifndef VK_USE_PLATFORM_WIN32_KHR
+#define VK_USE_PLATFORM_WIN32_KHR
+#endif
+#include "nvs30/common.hpp"
+#include "nvs30/log.hpp"
+#include "nvs30/dxgi_hooks.hpp"
+#include "vulkan_layer_entry.hpp"
+#include "interpolator.hpp"
+#include "pacing_clock.hpp"
+#include "performance.hpp"
+#include <d3d11_4.h>
+#include <dxgi1_6.h>
+#include <string>
+
+namespace {
+// Bridges that generate frames; while any exists, DXGI Presents (including a
+// driver's DXGI presentation underneath Vulkan) are passed through.
+std::atomic_int activeBridges{0};
