+ if(v12){out.edited=&v12->timelineSemaphore;out.previous=v12->timelineSemaphore;v12->timelineSemaphore=VK_TRUE;}
+ else if(tl){out.edited=&tl->timelineSemaphore;out.previous=tl->timelineSemaphore;tl->timelineSemaphore=VK_TRUE;}
