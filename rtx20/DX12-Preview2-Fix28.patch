+  }
+  if(acquired!=VK_SUCCESS&&acquired!=VK_SUBOPTIMAL_KHR)return acquired;
+  c.acquireTimeouts=0;
+  VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};bi.flags=VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  auto cb=s.generatedCommands;d.ResetCommandBuffer(cb,0);if(d.BeginCommandBuffer(cb,&bi)!=VK_SUCCESS)return VK_ERROR_INITIALIZATION_FAILED;
+  const VkImage image=c.images.at(index),source=g.output_image();
