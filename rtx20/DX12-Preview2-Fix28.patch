+ DWORD n=GetModuleFileNameW(nullptr,exe.data(),DWORD(exe.size()));if(!n||n>=exe.size())return false;exe.resize(n);
+ if(!GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS|GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,reinterpret_cast<LPCWSTR>(&module_in_executable_folder),&module))return false;
