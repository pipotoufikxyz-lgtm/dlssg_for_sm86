+// --- one game present ----------------------------------------------------
+class PresentOps final:public ChainOps {
+ Chain& c;VkQueue queue;const VkPresentInfoKHR& info;Slot& s;
+ bool captured{};
+ bool wait_slot(VkFence fence,bool& busy){
+  if(!busy)return true;auto& d=*c.device;
+  if(d.WaitForFences(d.device,1,&fence,VK_TRUE,1000000000ull)!=VK_SUCCESS)return false;
+  d.ResetFences(d.device,1,&fence);busy=false;return true;
+ }
+ // External images: hand ownership to/from the other API around each use.
+ std::uint32_t own()const{return c.generator->external()?c.queueFamily:VK_QUEUE_FAMILY_IGNORED;}
+ std::uint32_t outside()const{return c.generator->external()?VK_QUEUE_FAMILY_EXTERNAL:VK_QUEUE_FAMILY_IGNORED;}
+public:
+ PresentOps(Chain& chain,VkQueue q,const VkPresentInfoKHR& i,Slot& slot):c(chain),queue(q),info(i),s(slot){}
+ VkQueue present_queue()const override{return queue;}
+ bool ready(){return wait_slot(s.captureFence,s.captureBusy)&&wait_slot(s.generatedFence,s.generatedBusy);}
+ VkResult capture(std::uint64_t value,std::uint64_t previous)override{
+  auto& d=*c.device;auto& g=*c.generator;
+  const VkImage image=c.images.at(info.pImageIndices[0]),target=g.capture_image();
+  VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};bi.flags=VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+  auto cb=s.captureCommands;d.ResetCommandBuffer(cb,0);if(d.BeginCommandBuffer(cb,&bi)!=VK_SUCCESS)return VK_ERROR_INITIALIZATION_FAILED;
+  std::vector<VkImageMemoryBarrier> before,after;
+  const bool first=!c.layouts;
+  if(first){
+   // First use: both generator images enter GENERAL (contents undefined).
+   before.push_back(image_barrier(target,VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_GENERAL,0,VK_ACCESS_TRANSFER_WRITE_BIT));
+   before.push_back(image_barrier(g.output_image(),VK_IMAGE_LAYOUT_UNDEFINED,VK_IMAGE_LAYOUT_GENERAL,0,VK_ACCESS_TRANSFER_READ_BIT));
+   c.layouts=true;
+  }else if(g.external())before.push_back(image_barrier(target,VK_IMAGE_LAYOUT_GENERAL,VK_IMAGE_LAYOUT_GENERAL,0,VK_ACCESS_TRANSFER_WRITE_BIT,outside(),own()));
+  before.push_back(image_barrier(image,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,0,VK_ACCESS_TRANSFER_READ_BIT));
+  d.CmdPipelineBarrier(cb,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,std::uint32_t(before.size()),before.data());
+  auto region=whole(c.extent);
+  d.CmdCopyImage(cb,image,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,target,VK_IMAGE_LAYOUT_GENERAL,1,&region);
+  after.push_back(image_barrier(image,VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,VK_ACCESS_TRANSFER_READ_BIT,0));
+  after.push_back(image_barrier(target,VK_IMAGE_LAYOUT_GENERAL,VK_IMAGE_LAYOUT_GENERAL,VK_ACCESS_TRANSFER_WRITE_BIT,g.external()?0:VK_ACCESS_TRANSFER_READ_BIT,own(),outside()));
+  // The other API writes the output next; its first acquire below matches
+  // this release.
+  if(first&&g.external())after.push_back(image_barrier(g.output_image(),VK_IMAGE_LAYOUT_GENERAL,VK_IMAGE_LAYOUT_GENERAL,0,0,own(),outside()));
+  d.CmdPipelineBarrier(cb,VK_PIPELINE_STAGE_TRANSFER_BIT,VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT|VK_PIPELINE_STAGE_TRANSFER_BIT,0,0,nullptr,0,nullptr,std::uint32_t(after.size()),after.data());
+  if(d.EndCommandBuffer(cb)!=VK_SUCCESS)return VK_ERROR_INITIALIZATION_FAILED;
+  // Wait: the game's semaphores (its rendering) and the generator's
+  // previous work on the capture image. Signal: the real present's
+  // semaphore and the timeline value for the generator.
+  std::vector<VkSemaphore> waits(info.pWaitSemaphores,info.pWaitSemaphores+info.waitSemaphoreCount);
+  std::vector<std::uint64_t> waitValues(waits.size(),0);
+  std::vector<VkPipelineStageFlags> stages(waits.size(),VK_PIPELINE_STAGE_TRANSFER_BIT);
+  if(previous){waits.push_back(g.timeline());waitValues.push_back(previous);stages.push_back(VK_PIPELINE_STAGE_TRANSFER_BIT);}
+  VkSemaphore signals[2]={s.realReady,g.timeline()};std::uint64_t signalValues[2]={0,value};
+  VkTimelineSemaphoreSubmitInfo ti{VK_STRUCTURE_TYPE_TIMELINE_SEMAPHORE_SUBMIT_INFO};
+  ti.waitSemaphoreValueCount=std::uint32_t(waitValues.size());ti.pWaitSemaphoreValues=waitValues.data();ti.signalSemaphoreValueCount=2;ti.pSignalSemaphoreValues=signalValues;
+  VkSubmitInfo si{VK_STRUCTURE_TYPE_SUBMIT_INFO};si.pNext=&ti;
+  si.waitSemaphoreCount=std::uint32_t(waits.size());si.pWaitSemaphores=waits.data();si.pWaitDstStageMask=stages.data();
+  si.commandBufferCount=1;si.pCommandBuffers=&cb;si.signalSemaphoreCount=2;si.pSignalSemaphores=signals;
+  const auto r=d.QueueSubmit(queue,1,&si,s.captureFence);
+  if(r==VK_SUCCESS){captured=true;s.captureBusy=true;}
+  return r;
+ }
+ VkResult present_generated(std::uint64_t ready,std::uint64_t copied,bool& submitted)override{
+  auto& d=*c.device;auto& g=*c.generator;submitted=false;
+  std::uint32_t index=0;
