+}
+
+inline void load_device_functions(DeviceData& d){
+#define SMVK_LOAD(name) d.name=reinterpret_cast<PFN_vk##name>(d.gdpa(d.device,"vk" #name));
+ SMVK_DEVICE_FUNCTIONS(SMVK_LOAD)
+ SMVK_DEVICE_FUNCTIONS_PLATFORM(SMVK_LOAD)
