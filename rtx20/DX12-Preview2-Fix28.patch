+ auto get=reinterpret_cast<unsigned(WINAPI*)(char*,unsigned)>(GetProcAddress(module,"SmoothMotionGetStatus"));
+ if(!get){std::printf("status: unavailable\n");return;}
+ std::vector<char> b(65536);get(b.data(),unsigned(b.size()));
+ const std::string s(b.data());
+ for(const char* key:{"\"vulkan_layer\"","\"vulkan_generated_presents\"","\"vulkan_real_presents\"","\"vulkan_generation\""}){
+  const auto at=s.find(key);if(at==std::string::npos){std::printf("status %s missing\n",key);continue;}
+  std::printf("status %s\n",s.substr(at,s.find_first_of(",}",at)-at).c_str());
+ }
+}
+
