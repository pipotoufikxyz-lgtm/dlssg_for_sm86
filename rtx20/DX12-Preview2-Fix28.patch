+ // the dedicated struct (never both: Vulkan12Features covers it).
+ auto* v12=const_cast<VkPhysicalDeviceVulkan12Features*>(static_cast<const VkPhysicalDeviceVulkan12Features*>(find_struct(original->pNext,VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES)));
