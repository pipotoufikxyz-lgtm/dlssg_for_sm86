+// Fix28 host test: the Vulkan layer core with a pure-Vulkan stand-in
+// generator (its "interpolation" is a GPU copy of the captured frame), built
+// as a shared library and loaded by the real Vulkan loader into
+// vulkan_test_app under the Khronos validation layer (Mesa lavapipe). It
+// exercises the dispatch chain, device/swapchain changes, the capture, the
+// extra-image generated present and the real present with all semaphores.
+// The Windows D3D11 bridge and NVIDIA optical flow are not executed here.
+#include "vulkan_layer_entry.hpp"
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+std::atomic_uint generatedPresents{0},realPresents{0},captures{0};
+class CopyGenerator final:public smvk::Generator {
+ smvk::DeviceData& d;VkImage capture_{},output_{};VkDeviceMemory memory_[2]{};VkSemaphore timeline_{};
+ VkCommandPool pool_{};VkCommandBuffer work_[3]{};VkFence fences_[3]{};bool busy_[3]{};unsigned next_{};
+ std::uint64_t counter_{},lastWork_{},lastCopied_{};unsigned frames_{};
+ VkImage image(VkFormat format,VkExtent2D e,VkDeviceMemory& memory){
+  VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};ci.imageType=VK_IMAGE_TYPE_2D;ci.format=format;ci.extent={e.width,e.height,1};
+  ci.mipLevels=ci.arrayLayers=1;ci.samples=VK_SAMPLE_COUNT_1_BIT;ci.tiling=VK_IMAGE_TILING_OPTIMAL;
+  ci.usage=VK_IMAGE_USAGE_TRANSFER_SRC_BIT|VK_IMAGE_USAGE_TRANSFER_DST_BIT;ci.initialLayout=VK_IMAGE_LAYOUT_UNDEFINED;
+  VkImage out{};if(d.CreateImage(d.device,&ci,nullptr,&out)!=VK_SUCCESS)return VK_NULL_HANDLE;
+  VkMemoryRequirements req{};d.GetImageMemoryRequirements(d.device,out,&req);
+  VkPhysicalDeviceMemoryProperties mp{};d.instance->GetPhysicalDeviceMemoryProperties(d.physical,&mp);
