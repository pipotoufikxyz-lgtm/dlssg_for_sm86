+// --- device creation helpers --------------------------------------------
+// Extensions and features interpolation needs, added to the game's
+// vkCreateDevice only when the physical device supports all of them.
+struct DeviceAdditions {
+ std::vector<const char*> extensions;VkPhysicalDeviceTimelineSemaphoreFeatures timelineFeatures{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES};
+ VkDeviceCreateInfo info{};bool interop{};
+ // A feature flag set in the game's own structure (restored before the
+ // game's device is created unchanged).
+ VkBool32* edited{};VkBool32 previous{};
+ void restore(){if(edited){*edited=previous;edited=nullptr;}}
+};
+inline bool prepare_device(InstanceData& inst,VkPhysicalDevice physical,const VkDeviceCreateInfo* original,DeviceAdditions& out){
+ out.info=*original;
+ std::uint32_t n=0;inst.EnumerateDeviceExtensionProperties(physical,nullptr,&n,nullptr);
+ std::vector<VkExtensionProperties> available(n);inst.EnumerateDeviceExtensionProperties(physical,nullptr,&n,available.data());
+ out.extensions.assign(original->ppEnabledExtensionNames,original->ppEnabledExtensionNames+original->enabledExtensionCount);
+ VkPhysicalDeviceProperties props{};inst.GetPhysicalDeviceProperties(physical,&props);
+ const std::uint32_t api=std::min(props.apiVersion,inst.apiVersion);
+ std::vector<const char*> wanted=interop_extensions;
+ if(VK_API_VERSION_MINOR(api)<2&&VK_API_VERSION_MAJOR(api)==1)wanted.push_back(VK_KHR_TIMELINE_SEMAPHORE_EXTENSION_NAME);
+ if(VK_API_VERSION_MINOR(api)<1&&VK_API_VERSION_MAJOR(api)==1){logf("[vulkan] Device API 1.0: generation unavailable.\n");return false;}
+ for(auto* e:wanted)if(!has_extension(available,e)){logf("[vulkan] Device lacks %s: generation unavailable.\n",e);return false;}
