+struct Chain {
+ DeviceData* device{};VkSwapchainKHR swapchain{};VkFormat format{};VkExtent2D extent{};
+ std::vector<VkImage> images;std::uint32_t queueFamily{VK_QUEUE_FAMILY_IGNORED};
