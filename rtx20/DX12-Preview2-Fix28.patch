+ auto d=std::make_unique<DeviceData>();d->device=*out;d->physical=physical;d->instance=inst;d->gdpa=nextDevice;d->setLoaderData=setData;
+ load_device_functions(*d);d->timeline=enabled;d->externalInterop=enabled;
+ std::uint32_t n=0;inst->GetPhysicalDeviceQueueFamilyProperties(physical,&n,nullptr);d->families.resize(n);
+ inst->GetPhysicalDeviceQueueFamilyProperties(physical,&n,d->families.data());
+ logf("[vulkan] Device created: interpolation %s.\n",enabled?"available":"unavailable (pass-through)");
+ {auto& s=state();std::scoped_lock l(s.lock);s.devices[key(*out)]=std::move(d);}
+ return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL DestroyDevice(VkDevice device,const VkAllocationCallbacks* alloc){
+ std::unique_ptr<DeviceData> d;std::vector<std::unique_ptr<Chain>> orphans;
+ {auto& s=state();std::scoped_lock l(s.lock);auto i=s.devices.find(key(device));
+  if(i!=s.devices.end()){d=std::move(i->second);s.devices.erase(i);
+   for(auto c=s.chains.begin();c!=s.chains.end();)if(c->second->device==d.get()){orphans.push_back(std::move(c->second));c=s.chains.erase(c);}else ++c;}}
+ for(auto& c:orphans)destroy_chain_resources(*c);
