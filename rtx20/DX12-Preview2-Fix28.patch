+  // Dispatchable objects created by a layer carry the loader's dispatch.
+  if(d.setLoaderData){d.setLoaderData(d.device,b[0]);d.setLoaderData(d.device,b[1]);}
+  s.captureCommands=b[0];s.generatedCommands=b[1];
+  VkFenceCreateInfo fi{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  VkSemaphoreCreateInfo si{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+  if(d.CreateFence(d.device,&fi,nullptr,&s.captureFence)!=VK_SUCCESS||d.CreateFence(d.device,&fi,nullptr,&s.generatedFence)!=VK_SUCCESS)return false;
+  for(auto* sem:{&s.realReady,&s.acquired,&s.generatedDone})if(d.CreateSemaphore(d.device,&si,nullptr,sem)!=VK_SUCCESS)return false;
+ }
+ return true;
+}
+inline VkImageMemoryBarrier image_barrier(VkImage image,VkImageLayout from,VkImageLayout to,VkAccessFlags src,VkAccessFlags dst,
+                                          std::uint32_t srcFamily=VK_QUEUE_FAMILY_IGNORED,std::uint32_t dstFamily=VK_QUEUE_FAMILY_IGNORED){
+ VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};b.oldLayout=from;b.newLayout=to;b.srcAccessMask=src;b.dstAccessMask=dst;
+ b.srcQueueFamilyIndex=srcFamily;b.dstQueueFamilyIndex=dstFamily;b.image=image;b.subresourceRange={VK_IMAGE_ASPECT_COLOR_BIT,0,1,0,1};return b;
+}
+inline VkImageCopy whole(VkExtent2D e){
+ VkImageCopy r{};r.srcSubresource={VK_IMAGE_ASPECT_COLOR_BIT,0,0,1};r.dstSubresource=r.srcSubresource;r.extent={e.width,e.height,1};return r;
