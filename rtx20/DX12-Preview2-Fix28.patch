+ // functions: treat it as the loader's version (the device's own apiVersion
+ // is checked again at vkCreateDevice).
+ if(VK_API_VERSION_MINOR(d->apiVersion)==0)d->apiVersion=VK_API_VERSION_1_1;
+ logf("[vulkan] Layer active on instance %p (application API %u.%u%s).\n",static_cast<void*>(*out),VK_API_VERSION_MAJOR(requested),VK_API_VERSION_MINOR(requested),usedRaise?", raised to 1.1":"");
+ {auto& s=state();std::scoped_lock l(s.lock);s.instances[key(*out)]=std::move(d);}
+ return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL DestroyInstance(VkInstance instance,const VkAllocationCallbacks* alloc){
