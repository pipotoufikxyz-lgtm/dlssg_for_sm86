+#pragma once
+#include "nvs30/common.hpp"
+#include <memory>
+
+namespace sm20 {
+// Fix28: how real frames reach the D3D11 interpolator and generated frames
+// leave it, when the presentation is not a D3D11 swapchain: DX12Transfer
+// (D3D12 swapchains, shared textures) and the Vulkan bridge. The swapchain
+// argument is the DXGI swapchain for DX12 and null for Vulkan.
+class Transfer {
+public:
+ virtual ~Transfer()=default;
+ virtual ID3D11Device* device()const=0;
+ virtual ID3D11Texture2D* snapshot(unsigned slot=0)const=0;
+ virtual unsigned slots()const=0;
+ virtual void mark_d3d11_work()=0;
+ // The real frame is in snapshot(slot) for D3D11 work queued after this.
+ virtual HRESULT capture(IDXGISwapChain*,unsigned slot=0)=0;
+ virtual HRESULT write_generated(IDXGISwapChain*,ID3D11Texture2D*)=0;
+ virtual HRESULT write_original(IDXGISwapChain*,unsigned slot=0)=0;
+ virtual bool quiesce()=0;
+ virtual bool uncertain()const=0;
+};
+// A presentation outside DXGI (Vulkan): it supplies the transfer and what
+// the session would otherwise read from the swapchain.
+struct ExternalPresentation {
+ virtual ~ExternalPresentation()=default;
+ virtual std::unique_ptr<Transfer> create_transfer()=0;
+ virtual HWND window()const=0;
+ virtual const char* api()const=0;
+};
+}
