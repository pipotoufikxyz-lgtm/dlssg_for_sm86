+ const auto create=reinterpret_cast<PFN_vkCreateInstance>(next(VK_NULL_HANDLE,"vkCreateInstance"));
+ if(!create)return VK_ERROR_INITIALIZATION_FAILED;
+ // Interpolation needs Vulkan 1.1 instance functionality (external memory
+ // and semaphore capabilities, properties2). A 1.0 application gets a 1.1
+ // instance, which is backward compatible; if the loader or driver refuse
+ // it, the game's own request is used unchanged.
+ const std::uint32_t requested=info->pApplicationInfo?info->pApplicationInfo->apiVersion:0;
+ const bool raise=generator_factory&&VK_API_VERSION_MAJOR(requested)<=1&&VK_API_VERSION_MINOR(requested)==0;
+ VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};if(info->pApplicationInfo)app=*info->pApplicationInfo;
+ app.apiVersion=VK_API_VERSION_1_1;
+ VkInstanceCreateInfo raised=*info;raised.pApplicationInfo=&app;
+ auto r=create(raise?&raised:info,alloc,out);
+ bool usedRaise=raise&&r==VK_SUCCESS;
+ if(r!=VK_SUCCESS&&raise){
+  // Each layer below advanced the shared link; restore it for the retry.
+  link->u.pLayerInfo=below;
+  r=create(info,alloc,out);
+ }
+ if(r!=VK_SUCCESS)return r;
+ auto d=std::make_unique<InstanceData>();d->instance=*out;d->gipa=next;
+ d->apiVersion=usedRaise?VK_API_VERSION_1_1:(requested?requested:VK_API_VERSION_1_0);
+#define SMVK_I(name) d->name=reinterpret_cast<PFN_vk##name>(next(*out,"vk" #name));
+ SMVK_I(DestroyInstance) SMVK_I(EnumerateDeviceExtensionProperties) SMVK_I(GetPhysicalDeviceProperties) SMVK_I(GetPhysicalDeviceProperties2)
+ SMVK_I(GetPhysicalDeviceFeatures2) SMVK_I(GetPhysicalDeviceMemoryProperties) SMVK_I(GetPhysicalDeviceQueueFamilyProperties)
+ SMVK_I(GetPhysicalDeviceSurfaceCapabilitiesKHR) SMVK_I(GetPhysicalDeviceImageFormatProperties2) SMVK_I(DestroySurfaceKHR)
+#undef SMVK_I
