+VKAPI_ATTR VkResult VKAPI_CALL QueuePresentKHR(VkQueue queue,const VkPresentInfoKHR* info){
+ auto* d=device_of(queue);if(!d)return VK_ERROR_DEVICE_LOST;
+ struct Depth{Depth(){++present_depth;}~Depth(){--present_depth;}} depth;
