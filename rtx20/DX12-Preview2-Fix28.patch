+ // under their KHR names unless the instance enabled the extension.
+ if(!d->GetPhysicalDeviceProperties2)d->GetPhysicalDeviceProperties2=reinterpret_cast<PFN_vkGetPhysicalDeviceProperties2>(next(*out,"vkGetPhysicalDeviceProperties2KHR"));
+ if(!d->GetPhysicalDeviceFeatures2)d->GetPhysicalDeviceFeatures2=reinterpret_cast<PFN_vkGetPhysicalDeviceFeatures2>(next(*out,"vkGetPhysicalDeviceFeatures2KHR"));
