+inline PFN_vkVoidFunction device_hook(const char* name){
+#define H(fn) if(!std::strcmp(name,"vk" #fn))return reinterpret_cast<PFN_vkVoidFunction>(&fn);
+ H(GetDeviceProcAddr) H(DestroyDevice) H(GetDeviceQueue) H(GetDeviceQueue2) H(CreateSwapchainKHR) H(DestroySwapchainKHR) H(QueuePresentKHR)
+ return nullptr;
+}
+inline PFN_vkVoidFunction instance_hook(const char* name){
+ H(GetInstanceProcAddr) H(CreateInstance) H(DestroyInstance) H(CreateDevice) H(DestroySurfaceKHR)
+#ifdef _WIN32
+ H(CreateWin32SurfaceKHR)
+#endif
+#undef H
+ return nullptr;
+}
+// A hooked name is only returned where the next layer provides it: an
+// extension function the application did not enable must stay NULL.
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL GetDeviceProcAddr(VkDevice device,const char* name){
+ if(!std::strcmp(name,"vkGetDeviceProcAddr"))return reinterpret_cast<PFN_vkVoidFunction>(&GetDeviceProcAddr);
+ auto* d=device_of(device);if(!d)return nullptr;
+ const auto next=d->gdpa(device,name);if(!next)return nullptr;
+ if(auto f=device_hook(name))return f;
+ return next;
+}
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL GetInstanceProcAddr(VkInstance instance,const char* name){
+ if(!std::strcmp(name,"vkGetInstanceProcAddr"))return reinterpret_cast<PFN_vkVoidFunction>(&GetInstanceProcAddr);
+ if(!std::strcmp(name,"vkCreateInstance"))return reinterpret_cast<PFN_vkVoidFunction>(&CreateInstance);
+ if(!instance)return nullptr;
+ auto* i=instance_of(instance);if(!i)return nullptr;
+ const auto next=i->gipa(instance,name);if(!next)return nullptr;
+ if(auto f=instance_hook(name))return f;
+ if(auto f=device_hook(name))return f;
+ return next;
+}
+}
